{
    "name": "eyika/atom-reverb",
    "description": "A lightweight, dependency-free WebSocket broadcast server for the Atom framework — Laravel-Reverb-style.",
    "type": "library",
    "keywords": ["atom", "reverb", "websocket", "broadcasting", "pubsub"],
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "eyika/atom-framework": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Eyika\\Atom\\Reverb\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Eyika\\Atom\\Reverb\\Tests\\": "tests/"
        }
    },
    "extra": {
        "atom": {
            "providers": [
                "Eyika\\Atom\\Reverb\\ReverbServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
